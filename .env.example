# Turso (libSQL) database
DATABASE_URL="libsql://<your-db-name>.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="<your-turso-auth-token>"

# NextAuth
NEXTAUTH_SECRET="<generate-with: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"

# Pusher (real-time)
PUSHER_APP_ID="<your-pusher-app-id>"
PUSHER_KEY="<your-pusher-key>"
PUSHER_SECRET="<your-pusher-secret>"
PUSHER_CLUSTER="ap2"

# Mobile JWT (separate secret from NextAuth)
MOBILE_JWT_SECRET="<generate-with: openssl rand -base64 32>"

# Google OAuth (optional — for Google Sign-In)
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"

# Email (for password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="<your-smtp-user>"
SMTP_PASS="<your-smtp-password>"
SMTP_FROM="noreply@example.com"

# PDF parser microservice URL (Render)
PDF_PARSER_URL="https://<your-render-service>.onrender.com"
PDF_PARSER_SECRET="<generate-with: openssl rand -base64 32>"

# Gemini AI (transaction categorization)
GEMINI_API_KEY="<your-gemini-api-key>"

# Upstash Redis (optional — rate limiting; in-memory fallback used if omitted)
UPSTASH_REDIS_REST_URL="https://<your-upstash-endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-token>"
# — or the names the Vercel Marketplace Upstash integration injects (either pair works)
KV_REST_API_URL="https://<your-upstash-endpoint>.upstash.io"
KV_REST_API_TOKEN="<your-upstash-token>"

# Sign in with Apple (optional — only needed for the iOS app's Apple login)
APPLE_BUNDLE_ID="com.splititapp.ios"
APPLE_TEAM_ID="<your-apple-team-id>"
APPLE_KEY_ID="<your-sign-in-with-apple-key-id>"
# The .p8 key contents; keep the \n line breaks escaped in a single line
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vercel cron auth — Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*
CRON_SECRET="<generate-with: openssl rand -base64 32>"

# SplitIT Plus paywall start (ISO date). Unset = paywall off, everyone has full access.
PLUS_LAUNCH_DATE="2026-11-01T00:00:00Z"

# RevenueCat (store subscriptions): secret API key for subscriber lookups, and the exact
# Authorization header value configured on the RevenueCat webhook
REVENUECAT_SECRET_KEY="sk_<your-revenuecat-secret-key>"
REVENUECAT_WEBHOOK_AUTH="Bearer <generate-with: openssl rand -base64 32>"

# Unsplash (optional — group cover photo search; Wikipedia-only when omitted)
UNSPLASH_ACCESS_KEY="<your-unsplash-access-key>"

# Sentry (optional — crash/error monitoring; everything is a no-op while these are unset)
# Server-side DSN (route handlers, server components, proxy)
SENTRY_DSN="https://<key>@o<org-id>.ingest.sentry.io/<project-id>"
# Browser DSN for the public pages; inlined at build time so it must be set when building
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.sentry.io/<project-id>"
# Source-map upload at build time (Vercel). Leave all three unset to skip upload silently.
SENTRY_ORG="<your-sentry-org-slug>"
SENTRY_PROJECT="<your-sentry-project-slug>"
SENTRY_AUTH_TOKEN="<sentry-auth-token-with-project:releases-scope>"
